[Unit]
Description=Notify Telegram of IP Address on Boot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# setup.sh replaces /opt/rpi-toolkit with the actual install path
ExecStart=/usr/bin/python3 /opt/rpi-toolkit/ip_notifier/ip_notifier.py
WorkingDirectory=/opt/rpi-toolkit/
StandardOutput=append:/var/log/rpi-toolkit.log
StandardError=journal
# Runs as a dedicated low-privilege user, not root
User=nobody
Group=nogroup

[Install]
WantedBy=multi-user.target