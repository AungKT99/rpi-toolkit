#!/usr/bin/env python3
"""
rpi-toolkit — single entrypoint.

Usage:
    sudo ./rpi-toolkit

Launches the interactive TUI for configuring and
monitoring your Raspberry Pi 5.
"""

import os
import sys

# Ensure the project root is on sys.path so `tui` package is importable
PROJECT_ROOT = os.path.dirname(os.path.abspath(__file__))
if PROJECT_ROOT not in sys.path:
    sys.path.insert(0, PROJECT_ROOT)


def _check_textual():
    """Offer to install textual if it's missing."""
    try:
        import textual  # noqa: F401
    except ImportError:
        print("textual is not installed.")
        answer = input("Install it now? [Y/n]: ").strip().lower()
        if answer in ("", "y", "yes"):
            import subprocess
            try:
                subprocess.run(
                    [sys.executable, "-m", "pip", "install", "textual", "requests",
                     "--break-system-packages"],
                    check=True,
                )
            except subprocess.CalledProcessError:
                subprocess.run(
                    [sys.executable, "-m", "pip", "install", "textual", "requests"],
                    check=True,
                )
        else:
            print("Cannot launch TUI without textual. Exiting.")
            sys.exit(1)


if __name__ == "__main__":
    _check_textual()

    from tui.app import main
    main()
